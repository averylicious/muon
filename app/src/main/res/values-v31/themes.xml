<resources>
    <!-- Android 12+ defaults to Material You, so the launch background uses the same wallpaper
         neutrals the dynamic scheme is built from rather than a hardcoded guess. -->
    <style name="Theme.Muon" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:colorAccent">@android:color/system_accent1_600</item>
        <item name="android:windowBackground">@android:color/system_neutral1_10</item>
    </style>
</resources>
